# Copier en .env (jamais commité).

# Base TimescaleDB (docker-compose.dev.yml en local, service "db" en production).
DATABASE_URL=postgresql+asyncpg://sentinel:sentinel@localhost:5432/sentinel

# Origines acceptées pour les requêtes modifiantes et le WebSocket (anti-CSRF), séparées par des virgules.
# Dev : le proxy Vite présente VITE_BACKEND_URL du frontend (http://localhost:8000).
# Prod : https://192.168.50.10,https://sentinel.lan
ALLOWED_ORIGINS=http://localhost:8000

COOKIE_SECURE=true
SESSION_TTL_HOURS=12

# Documentation interactive sur /api/docs (désactivée en production).
EXPOSE_DOCS=true

DEVICE_ID=box01

# Fuseau des horaires d'occupation (paramètres de détection).
TIMEZONE=Europe/Paris

# Broker MQTT : ingestion (sentinel/vision/detection…) et commandes vers le boîtier.
# Développement : Mosquitto local sans TLS (docker-compose.dev.yml ou service déjà installé).
# Production (#11, #12) : MQTT_PORT=8883, MQTT_TLS=true et les certificats ci-dessous.
MQTT_ENABLED=true
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_TLS=false
MQTT_CA=../pki/ca.crt
MQTT_CERT=../pki/backend.crt
MQTT_KEY=../pki/backend.key

# Flux annoté du service vision (seul lecteur de l'ESP32-CAM, voir vision/.env.example).
# API de l'UNO Q (relaie l'ESP32-CAM, plusieurs spectateurs possibles) :
CAMERA_URL=http://talos.local:8000/camera/stream
# Ou le flux annoté du service vision : CAMERA_URL=http://127.0.0.1:8081/stream
# Authentification HTTP Basic du flux, vide s'il n'y en a pas.
CAMERA_USER=
CAMERA_PASSWORD=
# Captures enregistrées par le service vision (relatif au dossier backend/).
SNAPSHOT_DIR=../snapshots

# API capteurs de l'UNO Q (HTTP + WebSocket) : alternative à MQTT pour lire les capteurs.
# Adresse de base seulement : /health, /sensors et /ws/pir sont ajoutés par le backend. Vide = désactivée.
# Nom en .local (mDNS) : indépendant de l'IP de la carte, qui change selon le réseau.
# Ne pas lancer en même temps la passerelle MQTT du même boîtier.
SENSOR_API_URL=http://talos.local:8000
