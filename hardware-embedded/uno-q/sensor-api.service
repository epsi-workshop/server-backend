[Unit]
Description=UNO Q Sensor API
After=network-online.target

[Service]
WorkingDirectory=%h/sensor-api
# API_TOKEN, ALLOW_SIMULATION, ALLOWED_ORIGINS (voir api/security.py) ; fichier en chmod 600
EnvironmentFile=-%h/sensor-api/.env
ExecStart=%h/sensor-api/.venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
