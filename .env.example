# Copier en .env (jamais commité), puis : chmod 600 .env
# Mot de passe de la base : openssl rand -hex 24
POSTGRES_USER=sentinel
POSTGRES_DB=sentinel
POSTGRES_PASSWORD=

# Adresse d'écoute des ports publiés 443 et 8883 (0.0.0.0 = toutes les interfaces ; le pare-feu de l'hôte
# doit les limiter à 192.168.50.0/24, cahier des charges 8.4).
BIND_ADDR=0.0.0.0

# Origines du dashboard acceptées par le backend (anti-CSRF), séparées par des virgules.
ALLOWED_ORIGINS=https://192.168.50.10,https://sentinel.lan,https://localhost,https://127.0.0.1

TIMEZONE=Europe/Paris

# ESP32-CAM (seul client : le service vision). Authentification du flux si configurée sur la caméra.
CAMERA_URL=http://192.168.50.21:81/stream
CAMERA_USER=
CAMERA_PASSWORD=

# API HTTP de l'UNO Q (facultatif, vide = désactivé) : capteurs, porte, badge et armement en HTTP au lieu de
# MQTT, servo de la caméra, écran OLED. Attention : HTTP sans TLS ni authentification (voir DEPLOIEMENT.md).
# Ex. http://192.168.50.20:8000 (les noms en .local ne sont pas résolus dans les conteneurs).
SENSOR_API_URL=
SERVO_API_URL=
DISPLAY_API_URL=

# Détection d'anomalies : seuils du volet prédictif (projection à +15 min).
TEMP_LIMIT=27
HUMIDITY_LIMIT=80

# Notifications push (ntfy) : jeton du backend écrit par scripts/setup-ntfy.sh. Lien ouvert depuis la notification.
NTFY_TOPIC=sentinel-alertes
NTFY_TOKEN=
DASHBOARD_URL=https://sentinel.lan

# Superviseur (redémarrages depuis le dashboard) : jeton partagé backend/superviseur, openssl rand -hex 32.
# DOCKER_GID : groupe docker de l'hôte (getent group docker), qui donne accès au socket Docker.
SUPERVISOR_TOKEN=
DOCKER_GID=984
