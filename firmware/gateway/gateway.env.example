# Copier en gateway.env (jamais commité) sur le PC où l'Arduino est branché.

# Port série de l'Arduino : python serial_gateway.py --list-ports
SERIAL_PORT=COM3
SERIAL_BAUD=115200

DEVICE=box01

# Broker du PC serveur.
MQTT_HOST=192.168.50.10

# Production (jalon 3) : MQTTS sur 8883 avec certificat client box01 (mTLS, #11, #12).
# Le broker identifie le boîtier par le CN du certificat : pas de mot de passe.
# Chemins relatifs = relatifs à ce dossier. La clé privée ne quitte jamais ce PC (puis l'UNO Q).
MQTT_TLS=true
MQTT_PORT=8883
MQTT_CA=certs/ca.crt
MQTT_CERT=certs/box01.crt
MQTT_KEY=certs/box01.key

# En attendant la PKI : port 1884 sans TLS, identifiant + mot de passe (donné par l'admin du serveur).
# MQTT_TLS=false
# MQTT_PORT=1884
# MQTT_USER=box01
# MQTT_PASSWORD=
