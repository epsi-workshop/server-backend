# backend/.env sur l'UNO Q (copié par deploy.sh s'il n'existe pas encore).
DATABASE_URL=postgresql+asyncpg://sentinel:sentinel@localhost:5432/sentinel
# Site servi en HTTP par nginx sur talos.local : même origine acceptée, quelle que soit l'adresse utilisée.
ALLOWED_ORIGINS=http://talos.local
ALLOW_SAME_ORIGIN=true
COOKIE_SECURE=false
SESSION_TTL_HOURS=12
EXPOSE_DOCS=false
DEVICE_ID=box01
TIMEZONE=Europe/Paris

MQTT_ENABLED=true
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_TLS=false

CAMERA_URL=http://127.0.0.1:8081/stream
CAMERA_USER=
SNAPSHOT_DIR=../snapshots

SENSOR_API_URL=http://127.0.0.1:8000

FACE_MODELS_DIR=../models
FACES_DIR=../faces
