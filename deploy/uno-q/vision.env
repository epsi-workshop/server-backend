# vision/.env sur l'UNO Q (copié par deploy.sh s'il n'existe pas encore).
CAMERA_URL=http://127.0.0.1:8000/camera/stream
CAMERA_USER=
STREAM_HOST=127.0.0.1
STREAM_PORT=8081
SNAPSHOT_DIR=../snapshots

MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_TLS=false

MOTION_MIN_AREA=0.004
MOTION_CONFIRM=3
MOTION_WINDOW=5
SNAPSHOT_INTERVAL_S=3

SERVO_API_URL=http://127.0.0.1:8000
TRACK_SPEED=150
TRACK_INVERT=false
TRACK_HOME_AFTER_S=20

FACE_MODELS_DIR=../models
FACES_DIR=../faces
DISPLAY_API_URL=http://127.0.0.1:8000
