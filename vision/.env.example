# Copier en .env (jamais commité).

# ESP32-CAM : flux MJPEG de l'exemple CameraWebServer (le service vision est son seul client).
CAMERA_URL=http://192.168.50.21:81/stream
CAMERA_USER=
CAMERA_PASSWORD=

# Flux annoté lu par le backend (backend/.env : CAMERA_URL=http://127.0.0.1:8081/stream).
STREAM_HOST=127.0.0.1
STREAM_PORT=8081

# Captures, partagées avec le backend (backend/.env : SNAPSHOT_DIR=../snapshots).
SNAPSHOT_DIR=../snapshots

# Broker MQTT. Développement : Mosquitto local sans TLS. Production : 8883, TLS, certificat vision (#11, #12).
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_TLS=false
MQTT_CA=../pki/ca.crt
MQTT_CERT=../pki/vision.crt
MQTT_KEY=../pki/vision.key

# Sensibilité : plus petite zone en mouvement retenue (fraction de l'image), confirmation sur N images.
MOTION_MIN_AREA=0.004
MOTION_CONFIRM=3
MOTION_WINDOW=5
SNAPSHOT_INTERVAL_S=3

# Suivi : le servo de l'UNO Q oriente la caméra vers le mouvement. Vide = caméra fixe.
SERVO_API_URL=http://talos.local:8000
TRACK_SPEED=150
TRACK_INVERT=false
TRACK_HOME_AFTER_S=20
